<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/images"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <!-- android:background="@color/white" = el fondo de la aplicacion sera blanco -->

    <!-- AQUI INICAMOS -->

    <!-- Crear tarjeta principal -->
    <!-- puntintos: derecha, izquierda, abajo y arriba. (asi se centra) -->
    <!-- app:cardElevation="35dp" = sombreado -->
    <!-- app:cardCornerRadius="25dp"> = redondear -->
    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:backgroundTint="@color/white">

        <!-- para que se alinee a la tarjeta ponemos en match y wrap en un LinearYayout,
        orientation: vetical, gravity: center -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Para cambiar de color ponemos color: #... -->
            <!-- android:layout_marginTop="15dp" = ponemos unmargen hacia arriba y hacia abajo -->
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"
                android:text="Inicio de sesion"
                android:textColor="#000080"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- android:background="@drawable/bg_input" = pone la forma que creamos
             en res-drawable-nex-draw-->

            <!-- android:hint="Correo electronico" = poner dentro una "ayuda" -->

            <!-- android:paddingEnd="15dp" = poner un fin -->
            <!-- android:inputType="textEmailAddress" = proporciona un teclado para correo (es igual con el numDecimal) -->
            <!-- android:drawableStart="@drawable/baseline_email_24" = para mostrar
             el icono que pusimos con figuras de l isquierda, mas, y elegimos-->
            <!-- android:drawablePadding="10dp" = espacio del texto que tendra el texto -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/baseline_email_24"
                android:drawablePadding="10dp"
                android:hint="Correo electronico"
                android:textColorHint="#000000"
                android:inputType="textEmailAddress"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_input"
                android:drawableStart="@drawable/baseline_disabled_by_default_24"
                android:drawablePadding="10dp"
                android:hint="Contraseña"
                android:textColorHint="#000000"
                android:inputType="textPassword"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:textColor="#000000" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/button"
                android:text="INGRESAR"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- si no tiene cuenta -->
            <TextView
                android:id="@+id/tvCrearCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="20dp"
                android:text="Crear una cuenta"
                android:textColor="#000080"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- AQUI TERMINAMOS -->

</androidx.constraintlayout.widget.ConstraintLayout>